# ──────────────────────────────────────────────────────────────
# Banco de dados (MySQL)
# ──────────────────────────────────────────────────────────────
DB_HOST=localhost          # endereço do servidor MySQL (ou host do Aiven)
DB_PORT=3306               # porta padrão do MySQL (ou porta do Aiven, ex: 25131)
DB_USER=root               # usuário do banco (ex: avnadmin no Aiven)
DB_PASSWORD=               # senha do usuário
DB_NAME=techparts          # nome do banco de dados (ex: defaultdb no Aiven)
DB_SSL=false               # defina como true para bancos remotos com SSL obrigatório (como Aiven)

# ──────────────────────────────────────────────────────────────
# JWT (autenticação)
# ──────────────────────────────────────────────────────────────
JWT_SECRET=troque_por_uma_string_longa_e_aleatoria
JWT_EXPIRES_IN=8h          # ex: 1h, 8h, 7d

# ──────────────────────────────────────────────────────────────
# CORS — origens permitidas, separadas por vírgula, sem barra final
# ──────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ──────────────────────────────────────────────────────────────
# Proxy reverso (Nginx, Render, Railway, etc.)
# Descomente e ajuste se a API estiver atrás de um proxy.
# ──────────────────────────────────────────────────────────────
# TRUST_PROXY=1

# ──────────────────────────────────────────────────────────────
# Upload de imagens de produtos
# ──────────────────────────────────────────────────────────────
# Pasta onde as imagens são gravadas. EM PRODUÇÃO aponte para um volume
# persistente (ex.: /var/data/uploads), senão tudo é apagado a cada deploy.
# UPLOAD_DIR=/var/data/uploads
UPLOAD_MAX_MB=2           # tamanho máximo por imagem (padrão 2)
# URL pública da API, usada para montar imagem_url (sem barra no final).
# Vazio = URL relativa (/uploads/produtos/arquivo.jpg).
# PUBLIC_API_URL=https://sua-api.onrender.com
