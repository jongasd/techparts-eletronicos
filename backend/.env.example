# ──────────────────────────────────────────────────────────────
# Banco de dados (MySQL)
# ──────────────────────────────────────────────────────────────
DB_HOST=localhost          # endereço do servidor MySQL
DB_PORT=3306               # porta padrão do MySQL
DB_USER=root               # usuário do banco
DB_PASSWORD=               # senha do usuário
DB_NAME=techparts          # nome do banco de dados

# ──────────────────────────────────────────────────────────────
# JWT (autenticação)
# ──────────────────────────────────────────────────────────────
JWT_SECRET=troque_por_uma_string_longa_e_aleatoria
JWT_EXPIRES_IN=8h          # ex: 1h, 8h, 7d

# ──────────────────────────────────────────────────────────────
# CORS — origens permitidas, separadas por vírgula, sem barra final
# ──────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ──────────────────────────────────────────────────────────────
# Proxy reverso (Nginx, Render, Railway, etc.)
# Descomente e ajuste se a API estiver atrás de um proxy.
# ──────────────────────────────────────────────────────────────
# TRUST_PROXY=1
