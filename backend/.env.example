# ──────────────────────────────────────────────────────────────
# Banco local de desenvolvimento/teste (MySQL instalado na máquina)
# ──────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_techparts
DB_SSL=false

# Produção no Render com MySQL externo (ex.: Aiven): configure os valores
# reais em Render > Environment. Nunca versione usuário, senha ou host privado.
# DB_HOST=seu-host-mysql
# DB_PORT=25131
# DB_USER=seu-usuario
# DB_PASSWORD=sua-senha
# DB_NAME=seu-banco
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true

# ──────────────────────────────────────────────────────────────
# JWT (autenticação)
# ──────────────────────────────────────────────────────────────
JWT_SECRET=troque_por_uma_string_longa_e_aleatoria
JWT_EXPIRES_IN=8h          # ex: 1h, 8h, 7d

# ──────────────────────────────────────────────────────────────
# CORS — origens permitidas, separadas por vírgula, sem barra final
# ──────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Em produção, use a URL exata do frontend publicado:
# CORS_ORIGIN=https://seu-frontend.onrender.com

# ──────────────────────────────────────────────────────────────
# Proxy reverso (Nginx, Render, Railway, etc.)
# Descomente e ajuste se a API estiver atrás de um proxy.
# ──────────────────────────────────────────────────────────────
# TRUST_PROXY=1

# ──────────────────────────────────────────────────────────────
# Upload de imagens de produtos
# ──────────────────────────────────────────────────────────────
# Pasta onde as imagens são gravadas. EM PRODUÇÃO aponte para um volume
# persistente (ex.: /var/data/uploads), senão tudo é apagado a cada deploy.
# UPLOAD_DIR=/var/data/uploads
UPLOAD_MAX_MB=2           # tamanho máximo por imagem (padrão 2)
# URL pública da API, usada para montar imagem_url (sem barra no final).
# Vazio = URL relativa (/uploads/produtos/arquivo.jpg).
# PUBLIC_API_URL=https://sua-api.onrender.com
# Em produção, use um disco persistente do Render:
# UPLOAD_DIR=/var/data/uploads
